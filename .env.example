# ── RaksHex environment template ─────────────────────────────────────────────
# Copy to .env for local development and replace placeholders as needed.
# Never commit real credentials. Schema source of truth: apps/api/_core/env.ts

NODE_ENV=development
PORT=3000

# Auth — production requires a unique random value of at least 32 characters.
JWT_SECRET=replace-with-32-plus-char-random-secret
OWNER_OPEN_ID=

# Vault root key (AES-256-GCM) for encrypted credentials/PII.
# Production startup fails closed if this is absent or shorter than 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RAKSHEX_VAULT_KEY=replace-with-32-plus-char-random-secret

# Signed action receipts (Ed25519). Required when the governed gateway path is enabled.
# Generate a PKCS#8 PEM with:
# node -e "const {generateKeyPairSync}=require('crypto'); console.log(generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}).toString())"
RAKSHEX_RECEIPT_SIGNING_PRIVATE_KEY=
RAKSHEX_RECEIPT_SIGNING_KEY_ID=receipts-dev

# Local Docker Compose PostgreSQL defaults. Change POSTGRES_PASSWORD and this URL together.
POSTGRES_PASSWORD=rakshex
DATABASE_URL=postgresql://rakshex:rakshex@localhost:5432/rakshex

# Redis — production requires a real Redis URL; no in-memory fallback is allowed there.
REDIS_URL=redis://localhost:6379

# OAuth / identity. Manus fields are retained only for the legacy optional auth adapter.
VITE_APP_ID=
OAUTH_SERVER_URL=https://auth.manus.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional LLM / research integrations.
BUILT_IN_FORGE_API_URL=https://api.manus.app/forge
BUILT_IN_FORGE_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_URL=https://api.minimax.io/v1
MINIMAX_MODEL=minimaxai/minimax-m2.7
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-chat-v3-0324:free

# SMTP — production requires explicit SMTP_HOST/SMTP_USER/SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@rakshex.in
# Public web origin used in transactional links.
APP_URL=http://localhost:3001

# Notifications / monitoring.
SLACK_WEBHOOK_URL=
SENTRY_DSN=

# Payments — leave empty until the relevant payment rail is intentionally enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend + CORS. Production must set FRONTEND_URL explicitly.
FRONTEND_URL=http://localhost:3001
# Comma-separated additional exact origins; no wildcard domains.
CORS_ORIGINS=

# Production requires a unique bearer token for GET /metrics.
METRICS_TOKEN=

# GitHub App + webhooks — production requires an explicit webhook secret.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Internal service credentials. Leave empty when the associated path is disabled.
INTERNAL_SERVICE_SECRET=
GATEWAY_SERVICE_TOKEN=
LOG_LEVEL=info

# Research / enterprise (optional).
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_KEY_VAULT_URL=
GITHUB_ENTERPRISE_SLUG=
GITHUB_COPILOT_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATE=

# Frontend (apps/web).
NEXT_PUBLIC_TS_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Local sandbox demos only — never enable in production.
NEXT_PUBLIC_SANDBOX_MODE=false
